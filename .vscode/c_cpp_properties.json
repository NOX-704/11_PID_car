{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/Debug",
                "${workspaceFolder}/user_driver",
                "${env:MSPM0_SDK_ROOT}/source",
                "${env:MSPM0_SDK_ROOT}/source/third_party/CMSIS/Core/Include",
                "${env:TI_ARMCLANG_ROOT}/include",
                "${env:TI_ARMCLANG_ROOT}/include/c"
            ],
            "defines": [
                "__MSPM0G3507__",
                "__USE_SYSCONFIG__"
            ],
            "compilerPath": "${env:TI_ARMCLANG_ROOT}/bin/tiarmclang",
            "compilerArgs": [
                "-mcpu=cortex-m0plus",
                "-march=thumbv6m",
                "-mthumb",
                "-mfloat-abi=soft"
            ],
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "macos-clang-arm",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/Debug",
                    "${workspaceFolder}/user_driver",
                    "${env:MSPM0_SDK_ROOT}/source"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/Debug",
                "${workspaceFolder}/user_driver",
                "${env:MSPM0_SDK_ROOT}/source",
                "${env:MSPM0_SDK_ROOT}/source/third_party/CMSIS/Core/Include",
                "${env:TI_ARMCLANG_ROOT}/include",
                "${env:TI_ARMCLANG_ROOT}/include/c"
            ],
            "defines": [
                "__MSPM0G3507__",
                "__USE_SYSCONFIG__"
            ],
            "compilerPath": "${env:TI_ARMCLANG_ROOT}/bin/tiarmclang.exe",
            "compilerArgs": [
                "-mcpu=cortex-m0plus",
                "-march=thumbv6m",
                "-mthumb",
                "-mfloat-abi=soft"
            ],
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "windows-clang-arm",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/Debug",
                    "${workspaceFolder}/user_driver",
                    "${env:MSPM0_SDK_ROOT}/source"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
